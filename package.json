{
  "name": "release-shield",
  "version": "1.0.0",
  "private": true,
  "description": "ReleaseShield: pre-publish leak scanner for npm, PyPI and Docker artifacts",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-cli.mjs && next build",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "license:keygen": "node scripts/license-keygen.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
