# Server-only. Restricted key needs write access to: Products, Prices, Payment Links.
STRIPE_RESTRICTED_KEY=rk_live_xxx
# Public URL of the deployed site; used as the post-checkout redirect target.
NEXT_PUBLIC_SITE_URL=https://releaseshield.example.com
# Optional: forward captured leads (JSON POST) to a webhook (Zapier, Slack, CRM, etc.)
LEAD_WEBHOOK_URL=
# Optional: skip API creation and use pre-made payment links
STRIPE_PAYMENT_LINK_STANDARD=
STRIPE_PAYMENT_LINK_PRO=
# Ed25519 key for license tokens: generate with `npm run license:keygen`
LICENSE_PRIVATE_KEY=
# Shown in docs/snippets: the GitHub repo that hosts action.yml
NEXT_PUBLIC_GITHUB_ACTION_REF=releaseshield/release-shield@v1
